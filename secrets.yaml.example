# Copy this file to secrets.yaml. Do not share secrets.yaml or commit it to Git.
wifi_ssid: "YOUR_2_4_GHZ_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate your own 32-byte base64 key, e.g. with: openssl rand -base64 32
duplo_api_encryption_key: "REPLACE_WITH_YOUR_GENERATED_BASE64_KEY"

# Choose a long, unique password for ESPHome firmware updates.
duplo_ota_password: "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
